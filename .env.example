MONGODB_URI=mongodb://localhost:27017/erisapros
APP_ENVIRONMENT=development
AUTH_ENABLED=false
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

AWS_REGION=us-east-1
# Local development only. ECS uses its task role and does not need static AWS keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

EYELEVEL_API_KEY=
EYELEVEL_EXTRACT_URL=

GROUNDX_API_KEY=
GROUNDX_BUCKET_ID=
GROUNDX_API_BASE_URL=https://api.groundx.ai/api/v1
GROUNDX_POLL_SECONDS=3
GROUNDX_MAX_WAIT_SECONDS=90
GROUNDX_STRUCTURED_EXTRACT_ENABLED=true
LOW_CONFIDENCE_THRESHOLD=0.8
# Shadow mode records canonical validation decisions without changing reviewer proposals.
SCHEDULE_A_CANONICAL_VALIDATION_SHADOW_ENABLED=false
# Enable only after the approved golden corpus and live isolation gates pass.
SCHEDULE_A_CANONICAL_VALIDATION_ENABLED=true

SHAREFILE_SUBDOMAIN=erisapros
SHAREFILE_BASE_URL=https://erisapros.sharefile.com
SHAREFILE_API_BASE_URL=https://erisapros.sf-api.com
SHAREFILE_CLIENT_ID=
SHAREFILE_CLIENT_SECRET=
SHAREFILE_REDIRECT_URL=http://localhost:8001/api/sharefile/oauth/callback
SHAREFILE_TESTED_REDIRECT_URL=https://secure.sharefile.com/oauth/oauthcomplete.aspx
SHAREFILE_WEBHOOK_URL=
SHAREFILE_WEBHOOK_TOKEN=
SHAREFILE_INTAKE_FOLDER_ID=
SHAREFILE_INTAKE_FOLDER_PATH=
SHAREFILE_DISCOVER_SHARED_FOLDERS=true
SHAREFILE_SHARED_ROOT_FOLDER_ID=
SHAREFILE_POLL_ENABLED=true
SHAREFILE_POLL_INTERVAL_SECONDS=1800
SHAREFILE_WEBHOOK_AUTO_REGISTER_ENABLED=false
SHAREFILE_WEBHOOK_DISCOVERY_INTERVAL_SECONDS=3600

FTWLINK_KEY_ID=
FTWLINK_ENDPOINT_URL=https://www.ftwilliam.com/cgi-bin/ICmkKdJDZincjf9goHWVUbID/ftwLink/ftwLink.cgi
FTWLINK_SANDBOX_CUSTOMER_ID=
FTWLINK_SANDBOX_PLAN_ID=
FTWLINK_SANDBOX_YEAR=
FTWLINK_SANDBOX_FTW_CUSTOMER_ID=
FTWLINK_SANDBOX_FTW_PLAN_ID=
FTWLINK_SANDBOX_YEAR_END=
FTW_PLAN_PAGE_URL_TEMPLATE=https://ftwilliam.com/cgi-bin/index.cgi?#go=iframe&page=/cgi-bin/PlanDoc2.cgi&PerformDoc5500=1&plan={ftw_browser_customer_id},{ftw_browser_plan_id}&Year={year}
# Optional straight-through workflow. Keep every flag false until the demo-plan
# allowlist, saved FTW session, and update permission have been verified locally.
FTW_AUTOMATION_ENABLED=false
FTW_AUTOMATION_BRING_FORWARD_ENABLED=false
FTW_AUTOMATION_AUTO_SEND_ENABLED=false
FTW_AUTOMATION_CONFIDENCE_THRESHOLD=0.95
FTW_AUTOMATION_POLICY_VERSION=2026-09-11-v2
FTW_AUTOMATION_ALLOWED_TARGETS_JSON=[]
FTW_AUTOMATION_LEASE_SECONDS=600
# Store this file outside the repository; it contains an authenticated session.
FTW_BROWSER_STORAGE_STATE_PATH=
# ECS injects this value from Secrets Manager; use the path setting for local work.
FTW_BROWSER_STORAGE_STATE_JSON=
FTW_BROWSER_HEADLESS=true
FTW_BROWSER_TIMEOUT_SECONDS=45
FTW_BROWSER_AUDIT_DIRECTORY=outputs/ftw-automation

VITE_API_BASE_URL=http://localhost:8001
VITE_AUTH_ENABLED=false
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_APP_CLIENT_ID=
