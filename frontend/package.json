{
  "name": "erisapros-dashboard-frontend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "smoke:build": "node scripts/smoke-built-app.mjs",
    "test:performance": "node scripts/test-shared-polling-resource.mjs",
    "test:review-ui": "node scripts/test-review-table-layout.mjs && node scripts/test-ftw-failure-diagnostics.mjs",
    "test:dashboard-ui": "node scripts/test-dashboard-responsive-layout.mjs && node scripts/test-dashboard-company-groups.mjs",
    "test:field-rules-ui": "node scripts/test-field-rule-client-creation.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "amazon-cognito-identity-js": "^6.3.20",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.25",
    "typescript": "^5.5.3",
    "vite": "^8.0.16"
  }
}
